options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: USLP_DSP
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12.0]
    rotation: 0
    state: enabled

blocks:
- name: Df
  id: variable
  parameters:
    comment: ''
    value: int(Fraction(SPS*Rs/(samp_rate/decim_0)).limit_denominator(1000).denominator)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 1392.0]
    rotation: 0
    state: disabled
- name: Uf
  id: variable
  parameters:
    comment: ''
    value: int(Fraction(SPS*Rs/(samp_rate/decim_0)).limit_denominator(1000).numerator)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 1328.0]
    rotation: 0
    state: disabled
- name: decim
  id: variable
  parameters:
    comment: ''
    value: int(decim_0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [160, 1264.0]
    rotation: 0
    state: disabled
- name: decim_0
  id: variable
  parameters:
    comment: ''
    value: max(1, math.floor(samp_rate/(2*Rs)))
